# SPBFTUIT backend environment
# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env or paste real keys into source code.

PORT=8080
RUST_LOG=info
# Public HTTPS Mini App URL enables its launch button in private chats.
# Localhost is useful for web development but does not activate Telegram's Web App button.
WEBAPP_URL=http://localhost:5173

# Telegram BotFather token (required to run the Telegram bot and validate WebApp initData)
TELOXIDE_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_TELEGRAM_ID=0
DEV_BYPASS_AUTH=false

# PostgreSQL 16 with pgvector and pg_trgm
DATABASE_URL=postgres://smart_campus:change_me@localhost:5432/smart_campus
# Optional Neon direct endpoint (without -pooler). Used for SQLx migrations and Telegram polling lock.
# If DATABASE_URL uses Neon PgBouncer (-pooler), the backend derives the direct host automatically.
# DATABASE_URL_UNPOOLED=postgres://...

# OpenAI API key (needed for RAG embeddings/chat; optional for basic Telegram commands)
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Comma-separated frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
