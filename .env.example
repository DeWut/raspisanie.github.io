# Application
PORT=8080
RUST_LOG=info
# Replace with the deployed HTTPS URL of /miniapp/; example.com disables the bot button.
WEBAPP_URL=https://example.com/miniapp/

# Telegram bot token. The backend will use this same value for initData HMAC
# validation and the bot client (TELOXIDE_TOKEN is the canonical variable).
TELOXIDE_TOKEN=replace_me
ADMIN_TELEGRAM_ID=0
DEV_BYPASS_AUTH=false

# PostgreSQL 16 + pgvector
DATABASE_URL=postgres://smart_campus:change_me@localhost:5432/smart_campus

# OpenAI-compatible API
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# CORS: comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
